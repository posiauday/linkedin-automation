# --- Required -------------------------------------------------------------
CLAUDE_API_KEY=your_claude_api_key_here

# --- LinkedIn (required only when publishing) -----------------------------
# Get the token from https://www.linkedin.com/developers/apps
# Scopes needed: openid, profile, w_member_social
# Then run: python run.py whoami --client default   to get your person ID
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# --- Optional -------------------------------------------------------------
OPENAI_API_KEY=                      # images; posts work fine without it
CLAUDE_MODEL=claude-sonnet-5         # claude-opus-5 for higher quality, ~5x cost
LINKEDIN_API_VERSION=202405

# --- Safety switches ------------------------------------------------------
ENABLE_IMAGE_GENERATION=true
ENABLE_LINKEDIN_POSTING=false        # keep false until you have read the output

# --- Extra clients --------------------------------------------------------
# Each client profile names its own credential variables, so add one pair per
# client and reference them in clients/<slug>.yaml:
# LINKEDIN_ACCESS_TOKEN_ACME=
# LINKEDIN_PERSON_ID_ACME=
